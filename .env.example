# ==================================================================
# MILK-REPORTING PRODUCTION ENVIRONMENT VARIABLES
# ==================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. META PLATFORM INTEGRATION (Paid Ads & Organic Graph API)
#
# A System User token from Business Settings -> Users -> System Users,
# scoped: ads_read, read_insights, pages_show_list, pages_read_engagement,
# instagram_basic, instagram_manage_insights. The System User must also be
# assigned the ad account / Page / Instagram account as assets, or the token
# authenticates but sees nothing.
#
# This is the only Meta credential the app needs. A System User token is
# long-lived and self-contained, so there is deliberately no META_APP_ID /
# META_APP_SECRET here - those would only be required for an OAuth flow or
# token refresh, neither of which this app performs.
META_SYSTEM_USER_TOKEN=your-meta-system-user-token

# 2b. Secures the daily /api/ingest cron (vercel.json). Set this as a Vercel
# env var and Vercel automatically sends it as `Authorization: Bearer
# <value>` on cron-triggered requests - generate any random string.
CRON_SECRET=your-random-cron-secret

# 3. GOOGLE ANALYTICS 4 (Website analytics)
#
# A Google Cloud *service account*, not OAuth - the same reasoning as the
# Meta System User token above: long-lived, no consent screen, no refresh
# rotation, no per-client re-authorisation.
#
# Setup, once for the whole agency:
#   1. console.cloud.google.com -> create (or pick) a project.
#   2. APIs & Services -> Library -> enable BOTH:
#        "Google Analytics Data API"   (reporting)
#        "Google Analytics Admin API"  (listing properties)
#   3. IAM & Admin -> Service Accounts -> Create. No project roles needed;
#      access is granted inside GA4, not in Cloud IAM.
#   4. On the service account -> Keys -> Add key -> Create new key -> JSON.
#   5. Copy "client_email" and "private_key" out of that JSON below.
#
# Then, once per client property:
#   GA4 -> Admin -> Property access management -> add the client_email
#   address with the **Viewer** role. Nothing appears in the app's property
#   picker until this is done.
#
# GA_PRIVATE_KEY must keep its literal backslash-n escapes (hosting env vars
# cannot hold real newlines); the app unescapes them. Wrap it in quotes.
GA_SERVICE_ACCOUNT_EMAIL=milk-reporting@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# 4. GOOGLE ADS PLATFORM INTEGRATION
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CLIENT_ID=your-google-ads-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-google-ads-refresh-token

# 5. TIKTOK ADS PLATFORM INTEGRATION
TIKTOK_APP_ID=your-tiktok-app-id
TIKTOK_SECRET=your-tiktok-app-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token

# 6. AI ANALYST & DIAGNOSTICS (OPTIONAL)
GEMINI_API_KEY=your-gemini-api-key
